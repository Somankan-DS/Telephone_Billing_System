{
  "name": "telebill-pro",
  "version": "1.0.0",
  "description": "TeleBill Pro - Academic Telecom Billing & Customer Management Platform (OSS/BSS)",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "npx prisma db push --skip-generate && npx tsx prisma/seed.ts && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:e2e:runner": "tsx tests/e2e/test-runner.ts --all",
    "test:e2e:inprocess": "tsx tests/e2e/test-runner.ts --all --in-process",
    "test:e2e:tier1": "jest tests/e2e/tier1_feature_coverage.test.ts --runInBand",
    "test:e2e:tier2": "jest tests/e2e/tier2_boundaries_corners.test.ts --runInBand",
    "test:e2e:tier3": "jest tests/e2e/tier3_cross_feature.test.ts --runInBand",
    "test:e2e:tier4": "jest tests/e2e/tier4_realworld_scenarios.test.ts --runInBand",
    "test:e2e:bail": "jest tests/e2e --bail --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.6",
    "@types/pdfkit": "^0.13.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
